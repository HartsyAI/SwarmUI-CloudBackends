<Project Sdk="Microsoft.NET.Sdk">
  <!-- Unit tests for the Cloud Backends extension's pure logic. Build SwarmUI first (it provides SwarmUI.dll), then:
       dotnet test src/Extensions/SwarmUI-CloudBackends/Tests -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>SwarmUI-CloudBackends.Tests</AssemblyName>
    <LangVersion>latest</LangVersion>
    <TestProjectType>UnitTest</TestProjectType>
    <Nullable>Disable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../SwarmUI-CloudBackends.csproj" />
    <Reference Include="SwarmUI">
      <HintPath>../../../bin/live_release/SwarmUI.dll</HintPath>
    </Reference>
    <Compile Include="../../../GlobalUsings.cs" />
  </ItemGroup>
  <Import Project="../../../SwarmUI.deps.props" />
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.0" />
  </ItemGroup>
</Project>
